{
  "name": "zenix-pos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrationStatus.js",
    "db:verify": "node src/db/verifySchema.js",
    "db:audit-integrity": "node src/db/auditIntegrity.js",
    "check": "node scripts/checkSyntax.mjs",
    "telegram:webhook": "node scripts/setTelegramWebhook.js",
    "telegram:payment:webhook": "node scripts/setPaymentTelegramWebhook.js",
    "platform:admin": "node scripts/createPlatformAdmin.js",
    "seed:zenix-market": "node scripts/seedZenixMarket.js",
    "test": "node --test tests/*.test.mjs",
    "test:db": "node scripts/assertTestDatabase.js && node --test --test-isolation=none tests/databaseIntegration.test.mjs",
    "worker": "node src/worker.js",
    "test:http": "node scripts/assertTestDatabase.js && node --test --test-isolation=none tests/httpIntegration.test.mjs",
    "db:audit-subscriptions": "node src/db/auditSubscriptions.js",
    "recovery:compare": "node scripts/compareTenantRecovery.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  }
}
