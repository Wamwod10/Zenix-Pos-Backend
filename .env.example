NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@POOLED_NEON_HOST/neondb?sslmode=verify-full
# Direct (non-pooler) connection used only by the controlled migration command.
MIGRATION_DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DIRECT_NEON_HOST/neondb?sslmode=verify-full
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=35000
DB_IDLE_TX_TIMEOUT_MS=15000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=zenix_session
SESSION_TTL_DAYS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=zenixposbot
ZENIX_PAYMENT_BOT_TOKEN=
ZENIX_PAYMENT_ADMIN_CHAT_ID=
ZENIX_PAYMENT_ADMIN_USER_IDS=
ZENIX_PAYMENT_WEBHOOK_SECRET=
ZENIX_PAYMENT_BOT_USERNAME=zenixpaymentbot
PUBLIC_API_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Zenix POS Admin

# Trial OTP: absent provider/key disables trial verification; paid signup stays available.
SMS_PROVIDER=playmobile
SMS_API_URL=https://your-provider-host.example/send
SMS_API_USERNAME=
SMS_API_PASSWORD=
SMS_SENDER=
SMS_TIMEOUT_MS=5000
SMS_OTP_TEMPLATE=Zenix POS tasdiqlash kodi: {code}. Amal qilish muddati 5 daqiqa.
# Generate a unique random secret with at least32bytes. Never expose to frontend.
OTP_HMAC_SECRET=
# Explicit trusted ingress IP/CIDRs only. Blank ignores forwarded IP in production.
# Set from verified deployment network configuration; never use true or hop counts.
TRUST_PROXY=

# Read-only Neon recovery metadata. Existing http/manifest adapters remain supported.
BACKUP_PROVIDER=neon
NEON_API_TOKEN=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
BACKUP_API_URL=
BACKUP_API_TOKEN=
BACKUP_MANIFEST_PATH=
